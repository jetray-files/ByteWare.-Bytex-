--Hat Required: roblox.com/catalog/7063113820/Aluminium-Baseball-Bat
clickfling = false -- set to true for click-to-fling

local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local humanoid = char:WaitForChild("Humanoid")
local torso = char:WaitForChild("Torso")
local head = char:WaitForChild("Head")
local rightArm = char:WaitForChild("Right Arm")
local leftArm = char:WaitForChild("Left Arm")
local rightLeg = char:WaitForChild("Right Leg")
local leftLeg = char:WaitForChild("Left Leg")

-- Fling: apply velocity to all baseparts
local connections = {}
for _, part in ipairs(char:GetDescendants()) do
    if part:IsA("BasePart") then
        local conn = game:GetService("RunService").Heartbeat:Connect(function()
            pcall(function()
                part.Velocity = Vector3.new(-30, 0, 0)
                sethiddenproperty(player, "MaximumSimulationRadius", math.huge)
                sethiddenproperty(player, "SimulationRadius", 999999999)
                player.ReplicationFocus = workspace
            end)
        end)
        table.insert(connections, conn)
    end
end

-- Disable collisions for all baseparts (prevents getting stuck)
for _, part in ipairs(char:GetDescendants()) do
    if part:IsA("BasePart") then
        local conn1 = game:GetService("RunService").RenderStepped:Connect(function() part.CanCollide = false end)
        local conn2 = game:GetService("RunService").Stepped:Connect(function() part.CanCollide = false end)
        table.insert(connections, conn1)
        table.insert(connections, conn2)
    end
end

-- BodyVelocity for extra fling (optional)
local bv = Instance.new("BodyVelocity", root)
bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
bv.Velocity = Vector3.new(-30, 0, 0)

-- Click fling (if enabled)
local mouse = player:GetMouse()
local clickActive = false
if clickfling then
    mouse.Button1Down:Connect(function() clickActive = true end)
    mouse.Button1Up:Connect(function() clickActive = false end)
end

-- BodyPosition for click teleport
local bp = Instance.new("BodyPosition", root)
bp.P = 9e9
bp.D = 9e9
bp.MaxForce = Vector3.new(99999, 99999, 99999)

game:GetService("RunService").Heartbeat:Connect(function()
    if clickActive then
        bp.Position = mouse.Hit.p
        root.Position = mouse.Hit.p
    else
        bp.Position = torso.Position
    end
end)

-- SelectionBox for effect
local box = Instance.new("SelectionBox", root)
box.Adornee = root
box.LineThickness = 0.02
box.Color3 = Color3.fromRGB(250, 0, 0)
box.Name = "RAINBOW"

-- Movement with WASD and Space (using original humanoid)
local keys = {w=false, a=false, s=false, d=false, space=false}
mouse.KeyDown:Connect(function(k)
    if k == " " then keys.space = true end
    if k == "w" then keys.w = true end
    if k == "a" then keys.a = true end
    if k == "s" then keys.s = true end
    if k == "d" then keys.d = true end
end)
mouse.KeyUp:Connect(function(k)
    if k == " " then keys.space = false end
    if k == "w" then keys.w = false end
    if k == "a" then keys.a = false end
    if k == "s" then keys.s = false end
    if k == "d" then keys.d = false end
end)

local function moveCharacter(dirX, dirZ)
    local cf = root.CFrame
    local moveVec = cf:VectorToWorldSpace(Vector3.new(dirX, 0, dirZ))
    humanoid:MoveTo(root.Position + moveVec * 10)
end

game:GetService("RunService").RenderStepped:Connect(function()
    if keys.w then moveCharacter(0, 1) end
    if keys.s then moveCharacter(0, -1) end
    if keys.a then moveCharacter(-1, 0) end
    if keys.d then moveCharacter(1, 0) end
    if keys.space then humanoid.Jump = true end
    if not (keys.w or keys.a or keys.s or keys.d) then
        humanoid:MoveTo(root.Position) -- stop moving
    end
end)

-- Animation system (joint manipulation) - completely unchanged except references to reanim removed
-- We will use the original character's joints directly, no clone.
local sine = 1
local speed = 1
local Mode = "1" -- default idle

-- Joints
local RJ = root.RootJoint
local RS = torso["Right Shoulder"]
local LS = torso["Left Shoulder"]
local RH = torso["Right Hip"]
local LH = torso["Left Hip"]
local NECK = torso.Neck

-- Reset joints to default
NECK.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, 0)
NECK.C1 = CFrame.new(0, -0.5, 0) * CFrame.Angles(0, 0, 0)
RJ.C1 = CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, 0)
RJ.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)
RS.C1 = CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, 0)
LS.C1 = CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, 0)
RH.C1 = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, 0)
LH.C1 = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, 0)
RH.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)
LH.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)
RS.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)
LS.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, 0)

humanoid.WalkSpeed = 16

-- Mode switching (Q and E)
mouse.KeyDown:Connect(function(k)
    if k == "q" then
        Mode = "1"
        humanoid.WalkSpeed = 16
    elseif k == "e" then
        Mode = "2"
        humanoid.WalkSpeed = 35
    end
end)

-- Attack combo (click)
mouse.Button1Down:Connect(function()
    Mode = "Attack1"
    wait(0.1)
    Mode = "Attack2"
    wait(0.1)
    Mode = "Attack3"
    wait(0.3)
    Mode = "2" -- change to desired after attack
end)

-- Hat positioning (the bat) – uses original character
function hat(h, p, c1, c0, m)
    local handle = char[h].Handle
    local target = char[p]
    local weld = handle:FindFirstChild("AccessoryWeld") or Instance.new("Weld", handle)
    weld.Part0 = handle
    weld.Part1 = target
    weld.C1 = c1 or CFrame.new()
    weld.C0 = c0 or CFrame.new()
    if m then
        -- remove meshes if needed (function rmesh not included here, but you can add)
    end
end

-- Position the bat (default idle)
hat("Aluminium Baseball Bat", "Torso", CFrame.new(0,0,0), CFrame.new(0,0,-0.7) * CFrame.Angles(math.rad(0), math.rad(0), math.rad(-25)), false)

-- Main animation loop
local rs = game:GetService("RunService")
coroutine.wrap(function()
    while true do
        sine = sine + speed
        local vel = root.Velocity
        local yVel = vel.Y
        local mag = vel.Magnitude

        -- Determine walking/running
        local isWalking = mag > 1 and mag < 20
        local isRunning = mag >= 20
        local isJumping = yVel > 1
        local isFalling = yVel < -1
        local isIdle = mag < 2 and not isJumping and not isFalling

        if Mode == "1" then
            humanoid.WalkSpeed = 16
            if isJumping then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0,-1,0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1.5,0.5,0) * CFrame.Angles(0, math.rad(20), math.rad(45)), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-1.5,0.5,0) * CFrame.Angles(0, math.rad(-20), math.rad(-45)), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5,0,-1) * CFrame.Angles(math.rad(-20),0,0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5,0,-1) * CFrame.Angles(math.rad(-15),0,0), 0.2)
            elseif isFalling then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0,-1,0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1.5,0.5,0) * CFrame.Angles(0, math.rad(20), math.rad(45)), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-1.5,0.5,0) * CFrame.Angles(0, math.rad(-20), math.rad(-45)), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5,0,-1) * CFrame.Angles(math.rad(-20),0,0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5,0,-1) * CFrame.Angles(math.rad(-15),0,0), 0.2)
            elseif isIdle then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0, -1 + 0.05*math.sin(sine/50), 0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1.5, 0.5 + 0.05*math.sin(sine/50), 0), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-1.5, 0.5 + 0.05*math.sin(sine/50), 0), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5, -1 - 0.05*math.sin(sine/50), 0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5, -1 - 0.05*math.sin(sine/50), 0), 0.2)
            elseif isWalking then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0, -1.1 - 0.1*math.cos(sine/10), 0) * CFrame.Angles(math.rad(-10), math.rad(5*math.cos(sine/20)), math.rad(5*math.cos(sine/20))), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1.5, 0.5, 0) * CFrame.Angles(math.rad(-60*math.cos(sine/20)), 0, 0), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-1.5, 0.5, 0) * CFrame.Angles(math.rad(60*math.cos(sine/20)), 0, 0), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5, -1 - 0.2*math.sin(sine/20), -0.3*math.cos(sine/20)) * CFrame.Angles(math.rad(60*math.cos(sine/20)), 0, 0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5, -1 + 0.2*math.sin(sine/20), 0.3*math.cos(sine/20)) * CFrame.Angles(math.rad(-60*math.cos(sine/20)), 0, 0), 0.2)
            end
            -- Bat position for mode 1 (on torso)
            hat("Aluminium Baseball Bat", "Torso", CFrame.new(0,0,0), CFrame.new(0,0,-0.7) * CFrame.Angles(0,0,math.rad(-25)), false)
        elseif Mode == "2" then
            humanoid.WalkSpeed = 35
            if isJumping then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0,-1,0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1.5,0.5,0) * CFrame.Angles(0, math.rad(20), math.rad(45)), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-1.5,0.5,0) * CFrame.Angles(0, math.rad(-20), math.rad(-45)), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5,0,-1) * CFrame.Angles(math.rad(-20),0,0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5,0,-1) * CFrame.Angles(math.rad(-15),0,0), 0.2)
            elseif isFalling then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0,-1,0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1.5,0.5,0) * CFrame.Angles(0, math.rad(20), math.rad(45)), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-1.5,0.5,0) * CFrame.Angles(0, math.rad(-20), math.rad(-45)), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5,0,-1) * CFrame.Angles(math.rad(-20),0,0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5,0,-1) * CFrame.Angles(math.rad(-15),0,0), 0.2)
            elseif isIdle then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0, -1 + 0.05*math.sin(sine/50), 0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1, 0.05*math.sin(sine/50), -0.5) * CFrame.Angles(math.rad(100), math.rad(13.23), math.rad(-24.98)), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-0.14, -0.14 + 0.05*math.sin(sine/50), -0.5) * CFrame.Angles(math.rad(90), math.rad(20.87), math.rad(13.23)), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5, -1 - 0.05*math.sin(sine/50), 0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5, -1 - 0.05*math.sin(sine/50), 0), 0.2)
            elseif isRunning then
                NECK.C0 = NECK.C0:Lerp(CFrame.new(0,1,0), 0.2)
                RJ.C0 = RJ.C0:Lerp(CFrame.new(0, -1 + 0.1*math.sin(sine/7.5), 0) * CFrame.Angles(math.rad(-17.34), 0, 0), 0.2)
                RS.C0 = RS.C0:Lerp(CFrame.new(1, 0.1*math.sin(sine/7.5), -0.5) * CFrame.Angles(math.rad(50), math.rad(13.23), math.rad(-24.98)), 0.2)
                LS.C0 = LS.C0:Lerp(CFrame.new(-0.14, -0.14 + 0.1*math.sin(sine/7.5), -0.5) * CFrame.Angles(math.rad(50), math.rad(20.87), math.rad(13.23)), 0.2)
                RH.C0 = RH.C0:Lerp(CFrame.new(0.5, -1 - 0.2*math.sin(sine/15), -0.5*math.cos(sine/15)) * CFrame.Angles(math.rad(60*math.cos(sine/15)), 0, 0), 0.2)
                LH.C0 = LH.C0:Lerp(CFrame.new(-0.5, -1 + 0.2*math.sin(sine/15), 0.4*math.cos(sine/15)) * CFrame.Angles(math.rad(-60*math.cos(sine/15)), 0, 0), 0.2)
            end
            -- Bat on right arm for mode 2
            hat("Aluminium Baseball Bat", "Right Arm", CFrame.new(0,0,0), CFrame.new(0.9, 0.7, -1) * CFrame.Angles(math.rad(-90), math.rad(45), 0), false)
        elseif Mode == "Attack1" then
            RS.C0 = RS.C0:Lerp(CFrame.new(1, -0.5, 0) * CFrame.Angles(math.rad(120), math.rad(-35), 0), 0.2)
            LS.C0 = LS.C0:Lerp(CFrame.new(0, 0.25, -0.5) * CFrame.Angles(math.rad(90), math.rad(-15), math.rad(45)), 0.2)
        elseif Mode == "Attack2" then
            RS.C0 = RS.C0:Lerp(CFrame.new(1, -0.5, 0) * CFrame.Angles(math.rad(120), math.rad(-90), 0), 0.2)
            LS.C0 = LS.C0:Lerp(CFrame.new(0, 0.25, -0.5) * CFrame.Angles(math.rad(90), math.rad(-2.06), math.rad(45)), 0.2)
        elseif Mode == "Attack3" then
            RJ.C0 = RJ.C0:Lerp(CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-10), math.rad(20), 0), 0.2)
            RS.C0 = RS.C0:Lerp(CFrame.new(0, 0, -0.5) * CFrame.Angles(math.rad(188.99), math.rad(-193.1), math.rad(97.29)), 0.2)
            LS.C0 = LS.C0:Lerp(CFrame.new(-1, 0, 0.5) * CFrame.Angles(math.rad(89.64), math.rad(13.23), math.rad(-32.62)), 0.2)
        end

        rs.RenderStepped:Wait()
    end
end)()

-- Cleanup on reset
player.CharacterAdded:Connect(function()
    for _, conn in ipairs(connections) do
        conn:Disconnect()
    end
end)
